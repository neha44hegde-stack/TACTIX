<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.neha.tactix.controller.MainMenuController"
      alignment="CENTER" spacing="18" prefWidth="560" prefHeight="700"
      styleClass="screen">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
    <Label text="TACTIX" styleClass="title"/>
    <Label text="Intelligent Tic-Tac-Toe" styleClass="subtitle"/>
    <VBox spacing="12" alignment="CENTER" maxWidth="280">
        <Button text="Play"        onAction="#onPlay"      styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="How to Play" onAction="#onHowToPlay" maxWidth="Infinity"/>
        <Button text="Settings"    onAction="#onSettings"  maxWidth="Infinity"/>
        <Button text="Exit"        onAction="#onExit"      maxWidth="Infinity"/>
    </VBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.neha.tactix.controller.SettingsController"
      alignment="CENTER" spacing="20" prefWidth="560" prefHeight="700" styleClass="screen">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
    <Label text="Settings" styleClass="title-small"/>
    <VBox spacing="14" maxWidth="340">
        <CheckBox fx:id="soundCheck"      text="Sound Enabled"/>
        <CheckBox fx:id="lightThemeCheck" text="Light Theme"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Default Difficulty:"/>
            <ComboBox fx:id="difficultyCombo" prefWidth="140"/>
        </HBox>
    </VBox>
    <HBox spacing="12">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Save" onAction="#onSave" styleClass="primary-button"/>
    </HBox>
</VBox>